# Copy this file to .env and replace the placeholder values.
SPOTIFY_CLIENT_ID=replace-with-your-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-with-your-spotify-client-secret
TOKEN_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Optional. Defaults to 8080.
PORT=8080

# Optional database overrides. Defaults to an in-memory H2 database.
# DATABASE_URL=jdbc:postgresql://localhost:5432/vibemusic
# DATABASE_USERNAME=vibemusic
# DATABASE_PASSWORD=replace-with-database-password
