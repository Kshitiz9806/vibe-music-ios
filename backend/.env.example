# Copy this file to .env and replace the placeholder values.
SPOTIFY_CLIENT_ID=replace-with-your-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-with-your-spotify-client-secret
TOKEN_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Optional. Defaults to 8080.
PORT=8080

# Optional. Paste the single connection URL from your database provider.
# Defaults to an in-memory H2 database when omitted.
# Keep the URL quoted because it may contain & characters.
# DATABASE_URL='postgres://user:password@host:5432/database?sslmode=require'
