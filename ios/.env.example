# Copy this file to .env. The Client ID is public and is embedded in the app.
PRODUCT_BUNDLE_IDENTIFIER=app.vibemusic.ios
SPOTIFY_CLIENT_ID=replace-with-your-spotify-client-id

# For a physical iPhone, replace the IP with your Mac's current Wi-Fi address.
# For the iOS Simulator, use http://127.0.0.1:8080 instead.
API_BASE_URL=http://192.168.1.10:8080

OAUTH_REDIRECT_URI=app.vibemusic.ios://oauth-callback
APP_REMOTE_REDIRECT_URI=app.vibemusic.ios://spotify-login-callback
